#!/usr/bin/env bash
# Every check a change must pass, run on this machine: the Rust build, tests and clippy, `bash -n` on the scripts,
# then install.sh's shared add_signed_repo hash and install.sh itself against stubbed pacman (tests/install_test.sh).
set -euo pipefail
cd "$(dirname "$0")/.."
export PATH="$HOME/.cargo/bin:$PATH"

scripts/build-llama.sh
cargo build --locked --all-targets
cargo test --locked
cargo clippy --locked --all-targets -- -D warnings

bash -n install.sh packaging/PKGBUILD packaging/recall-for-omarchy.install scripts/build-llama.sh omarchy/bundle.sh \
  bin/arch-run bin/build-packages bin/check bin/collect-packages bin/release bin/validate-models bin/verify-release \
  tests/install_test.sh
tests/install_test.sh

printf '\nAll checks passed.\n'
